<Window x:Class="ISFPConnectLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ISFP-Connect-Lite" Height="60" SizeToContent="Width"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="True" Topmost="False"
        Icon="{x:Static local:App.Icon}"
        xmlns:local="clr-namespace:ISFPConnectLite">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border CornerRadius="10" Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.55"/>
        </Border.Effect>

        <Grid Style="{StaticResource DragGridStyle}" MouseLeftButtonDown="Bar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ===== left content (login / online) ===== -->
            <Grid Grid.Column="0" Margin="14,0">
                <!-- ===== login panel ===== -->
                <StackPanel x:Name="LoginPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="assets/logo.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="ISFP" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,1,0"/>
                    <TextBlock Text=" Connect Lite" FontSize="13" VerticalAlignment="Center"
                               Foreground="{StaticResource DimBrush}" Margin="0,0,18,0"/>

                    <TextBlock Text="呼号" Style="{StaticResource BarLabel}" Margin="0,0,6,0"/>
                    <TextBox x:Name="CallsignBox" Style="{StaticResource BarTextBox}" Width="92"
                             MaxLength="10" CharacterCasing="Upper" VerticalAlignment="Center" Margin="0,0,10,0"
                             ToolTip="呼号，如 CCA1234 或 N123CA"/>
                    <TextBlock Text="机型" Style="{StaticResource BarLabel}" Margin="0,0,6,0"/>
                    <TextBox x:Name="EquipBox" Style="{StaticResource BarTextBox}" Width="64"
                             MaxLength="4" CharacterCasing="Upper" VerticalAlignment="Center" Margin="0,0,10,0"
                             ToolTip="机型 ICAO，如 A320 / B738 / C172"/>
                    <TextBlock Text="航司" Style="{StaticResource BarLabel}" Margin="0,0,6,0"/>
                    <TextBox x:Name="AirlineBox" Style="{StaticResource BarTextBox}" Width="64"
                             MaxLength="10" CharacterCasing="Upper" VerticalAlignment="Center" Margin="0,0,10,0"
                             ToolTip="航司 ICAO（涂装），如 CES / CCA"/>
                    <Button x:Name="SettingsBtn" Style="{StaticResource IconButton}" Content="&#xE713;"
                            ToolTip="设置" Click="Settings_Click" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="ConnectBtn" Style="{StaticResource AccentButton}" Content="连 线"
                            Click="Connect_Click" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- ===== online panel ===== -->
                <StackPanel x:Name="OnlinePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Image Source="assets/logo.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Ellipse x:Name="StatusDot" Style="{StaticResource StatusDot}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="CallsignText" Style="{StaticResource BarValue}" FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <!-- 每组 = 标签+值（标签右距6，值右距18），组内间距统一 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                        <TextBlock Text="频率" Style="{StaticResource BarLabel}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="FreqText" Style="{StaticResource BarValue}" VerticalAlignment="Center" Width="56"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                        <TextBlock Text="应答机" Style="{StaticResource BarLabel}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="SquawkText" Style="{StaticResource BarValue}" VerticalAlignment="Center" Width="40"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                        <TextBlock Text="地速" Style="{StaticResource BarLabel}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="GsText" Style="{StaticResource BarValue}" VerticalAlignment="Center" Width="44"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="高度" Style="{StaticResource BarLabel}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="AltText" Style="{StaticResource BarValue}" VerticalAlignment="Center" Width="56"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ===== right-side actions ===== -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                <Button x:Name="FlightPlanBtn" Style="{StaticResource AccentButton}" Content="飞行计划" FontSize="11"
                        Height="24" Padding="10,0" VerticalAlignment="Center"
                        ToolTip="打开 ISFP 飞行计划提交页面" Click="FlightPlan_Click" Margin="0,0,8,0"/>
                <ToggleButton x:Name="MsgBtn" Style="{StaticResource ToggleButtonStyle}" Content="&#xE8BD;" FontSize="12"
                              ToolTip="消息" Checked="Msg_Checked" Unchecked="Msg_Unchecked"
                              Visibility="Collapsed" Margin="0,0,8,0"/>
                <Button x:Name="DiscBtn" Style="{StaticResource IconButton}" Content="&#xE8E8;" FontSize="12"
                        ToolTip="断开连接" Click="Disconnect_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                <ToggleButton x:Name="PinBtn" Style="{StaticResource ToggleButtonStyle}" Content="&#xE718;" FontSize="12"
                              ToolTip="窗口置顶" Checked="Pin_Checked" Unchecked="Pin_Unchecked" Margin="0,0,8,0"/>
                <Button x:Name="CloseBtn" Style="{StaticResource IconButton}" Content="&#xE8BB;"
                        ToolTip="退出" Click="Close_Click"/>
            </StackPanel>

            <!-- status toast -->
            <Border x:Name="Toast" Grid.ColumnSpan="2" Background="{StaticResource PanelAltBrush}" CornerRadius="6"
                    Padding="12,6" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="Collapsed" MaxWidth="420">
                <TextBlock x:Name="ToastText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Border>
</Window>
