<Window x:Class="ISFPConnectLite.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="340" Width="420"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Border CornerRadius="10" Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
            MouseLeftButtonDown="Window_DragMove">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>
        <Grid Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="设 置" FontWeight="Bold" FontSize="15"
                           Foreground="{StaticResource TextBrush}"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                        Click="Cancel_Click"/>
            </Grid>

            <StackPanel Grid.Row="1">
                <TextBlock Text="真实姓名" Foreground="{StaticResource DimBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="RealNameBox" Style="{StaticResource BarTextBox}"
                         ToolTip="登录包 Real Name 字段" Margin="0,0,0,12"/>

                <TextBlock Text="账号" Foreground="{StaticResource DimBrush}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CidBox" Grid.Column="0" Style="{StaticResource BarTextBox}" MaxLength="10"
                             ToolTip="平台 CID"/>
                    <PasswordBox x:Name="PwdBox" Grid.Column="2" Style="{StaticResource BarPassword}" MaxLength="64"
                                 ToolTip="平台密码"/>
                </Grid>
                <CheckBox x:Name="RememberPwd" Style="{StaticResource FlatCheck}" Content="记住密码"
                          Margin="0,0,0,14"/>

                <TextBlock Text="X-Plane 目录" Foreground="{StaticResource DimBrush}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="XpDirBox" Grid.Column="0" Style="{StaticResource BarTextBox}"
                             ToolTip="X-Plane 安装根目录（含 X-Plane.exe 的目录）"/>
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="浏览" Padding="10,0"
                            Click="BrowseXpDir_Click"/>
                    <Button x:Name="InstallPluginBtn" Grid.Column="4" Style="{StaticResource AccentButton}" Content="安装插件"
                            Padding="10,0" Click="InstallPlugin_Click"
                            ToolTip="将 ISFP-xLink 插件安装到 X-Plane/Resources/plugins"/>
                </Grid>
                <TextBlock x:Name="PluginStatusText" Style="{StaticResource BarLabel}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Style="{StaticResource GhostButton}" Content="取消" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Style="{StaticResource AccentButton}" Content="保 存" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
