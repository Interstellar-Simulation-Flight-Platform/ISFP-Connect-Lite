<Window x:Class="ISFPConnectLite.MessagePanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="消息" Height="420" Width="520" MinHeight="300" MinWidth="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="Manual">
    <Border CornerRadius="10" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
            MouseLeftButtonDown="Window_DragMove">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>
        <Grid Margin="14,12" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" Margin="0,0,0,10" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="消息" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TargetText" Foreground="{StaticResource DimBrush}" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                        Click="Close_Click"/>
            </Grid>

            <!-- message list -->
            <ListBox x:Name="MsgList" Grid.Row="1" Style="{StaticResource MsgListBoxSlim}"
                     ItemContainerStyle="{StaticResource MsgItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3">
                            <TextBlock Foreground="{StaticResource DimBrush}" FontSize="11">
                                <Run Text="{Binding Sender}"/><Run Text="  "/><Run Text="{Binding TimeStr}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Body}" Foreground="{StaticResource TextBrush}"
                                       TextWrapping="Wrap" Margin="0,1,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- target selector -->
            <Grid Grid.Row="2" Margin="0,8,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TargetBox" Style="{StaticResource BarTextBox}"
                         ToolTip="接收方：呼号 或 频率（如 118.1）"/>
                <Button x:Name="FreqBtn" Grid.Column="2" Style="{StaticResource GhostButton}"
                        Content="当前频率" Click="UseFreq_Click" ToolTip="发送到当前 COM1 频率"/>
            </Grid>

            <!-- input -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" Style="{StaticResource BarTextBox}" KeyDown="InputBox_KeyDown"
                         ToolTip="输入消息，Enter 发送"/>
                <Button Grid.Column="2" Style="{StaticResource AccentButton}" Content="发送" Click="Send_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
